<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/liveClassRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A1020"
    android:padding="12dp">

    <!-- Cabeçalho -->
    <TextView
        android:id="@+id/liveClassTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ALDAIR ONE"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp" />

    <!-- Estado da ligação -->
    <TextView
        android:id="@+id/liveClassStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="A preparar a sala..."
        android:textColor="#9DB8E8"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="8dp" />

    <!-- Vídeo dos participantes remotos -->
    <FrameLayout
        android:id="@+id/remoteVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:background="#17243B">

        <io.livekit.android.renderer.SurfaceViewRenderer
            android:id="@+id/remoteVideoRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/remoteVideoPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="A aguardar o formador..."
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="16sp" />

    </FrameLayout>

    <!-- Pré-visualização da câmara local -->
    <FrameLayout
        android:id="@+id/localVideoContainer"
        android:layout_width="120dp"
        android:layout_height="160dp"
        android:layout_gravity="end"
        android:layout_marginTop="10dp"
        android:background="#263B5C">

        <io.livekit.android.renderer.SurfaceViewRenderer
            android:id="@+id/localVideoRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/localVideoPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="A tua câmara"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textSize="12sp" />

    </FrameLayout>

    <!-- Controlos da aula -->
    <LinearLayout
        android:id="@+id/liveClassControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/btnMicrophone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Microfone"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Câmara"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnLeaveClass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sair"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
